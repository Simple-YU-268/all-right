{
  "name": "all-right",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ALL RIGHT 全对 · 电子刷题台：导入 JSON 题库，按分类或随机抽题，错题自动收进错题本，看板追踪进度与正确率。",
  "author": "ALL RIGHT 全对",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify:electron": "node scripts/verify-electron.mjs",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "verify:portable": "node scripts/verify-portable.mjs",
    "verify:installer": "node scripts/verify-installer.mjs",
    "icon": "node scripts/make-icon.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build && npm run icon && electron-builder --win --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.allright.quandui",
    "productName": "ALL RIGHT 全对",
    "copyright": "ALL RIGHT 全对 · 电子刷题台",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "ALLRIGHT-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ALL RIGHT 全对",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "ALLRIGHT-Portable-${version}.${ext}"
    }
  }
}
