{
  "name": "all-right",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "description": "ALL RIGHT 全对 · 电子刷题台：导入 JSON 题库，按分类或随机抽题，错题自动收进错题本，看板追踪进度与正确率。",
  "author": "ALL RIGHT 全对",
  "scripts": {
    "notices": "node scripts/generate-notices.mjs && node scripts/generate-rust-notices.mjs",
    "schema": "node scripts/generate-bank-schema.mjs",
    "mcp": "node mcp/launch.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "verify:bank-validation": "node scripts/verify-bank-validation.mjs",
    "verify:release-resources": "node scripts/verify-release-resources.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "dev": "vite",
    "build": "npm run build:looseleaf-css && tsc -b && vite build",
    "build:looseleaf-css": "node scripts/build-looseleaf-css.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify:chapters": "node scripts/verify-chapters.mjs",
    "verify:chapter-management": "node scripts/verify-chapter-management.mjs",
    "verify:image-questions": "node scripts/verify-image-questions.mjs",
    "verify:math": "node scripts/verify-math.mjs",
    "verify:themes": "node scripts/verify-themes.mjs",
    "verify:session-recovery": "node scripts/verify-session-recovery.mjs",
    "verify:chapter-resume": "node scripts/verify-chapter-resume.mjs",
    "verify:stat-isolation": "node scripts/verify-stat-isolation.mjs",
    "verify:review-search": "node scripts/verify-review-search.mjs",
    "verify:verdict-box": "node scripts/verify-verdict-box.mjs",
    "verify:native-session": "node scripts/verify-native-session.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:tauri": "node scripts/verify-tauri.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "make:sample-pack": "node scripts/make-sample-image-pack.mjs",
    "vendor:katex-fonts": "node scripts/vendor-katex-fonts.mjs",
    "vendor:looseleaf": "node scripts/vendor-looseleaf.mjs",
    "icon": "node scripts/make-icon.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run notices && npm run schema && npm run build:mcp-native && tauri build",
    "build:mcp-native": "node scripts/build-mcp-native.mjs",
    "tauri:icon": "npm run icon && tauri icon build/icon.png"
  },
  "dependencies": {
    "@icon-park/react": "^1.4.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.56.0",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
