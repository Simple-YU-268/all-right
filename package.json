{
  "name": "all-right",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "description": "ALL RIGHT 全对 · 电子刷题台：导入 JSON 题库，按分类或随机抽题，错题自动收进错题本，看板追踪进度与正确率。",
  "author": "ALL RIGHT 全对",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify:chapters": "node scripts/verify-chapters.mjs",
    "verify:chapter-management": "node scripts/verify-chapter-management.mjs",
    "verify:tauri": "node scripts/verify-tauri.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "icon": "node scripts/make-icon.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "npm run icon && tauri icon build/icon.png"
  },
  "dependencies": {
    "@icon-park/react": "^1.4.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@tauri-apps/cli": "^2.0.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
