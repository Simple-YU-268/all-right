{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ALL RIGHT 全对",
  "version": "0.7.0",
  "identifier": "com.allright.quandui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ALL RIGHT 全对",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost 'self' ws://127.0.0.1:5173"
    }
  },
  "bundle": {
    "resources": ["resources/node.exe", "resources/mcp-server.mjs", "resources/mcp-selftest.mjs", "resources/NODE-LICENSE.txt", "resources/rust-source-supplement.zip", "resources/THIRD_PARTY_NOTICES.md", "resources/RUST_THIRD_PARTY_NOTICES.md"],
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
